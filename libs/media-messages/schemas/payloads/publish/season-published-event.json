{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "season_published_event",
  "description": "Definition of the TV show season publish format.",
  "properties": {
    "content_id": {
      "$ref": "./common.json#/definitions/season_id"
    },
    "tvshow_id": {
      "$ref": "./common.json#/definitions/tvshow_id"
    },
    "index": {
      "description": "Season number",
      "type": "integer",
      "minimum": 1
    },
    "synopsis": {
      "description": "Short description of the main plot elements.",
      "$ref": "../common.json#/definitions/non_empty_string"
    },
    "description": {
      "description": "Extended synopsis.",
      "type": "string"
    },
    "studio": {
      "description": "Name of the producing studio.",
      "type": "string"
    },
    "title": {
      "description": "Title of the season.",
      "$ref": "../common.json#/definitions/non_empty_string"
    },
    "original_title": {
      "description": "Original title of the season.",
      "type": "string"
    },
    "released": {
      "description": "Date of first release.",
      "$ref": "./common.json#/definitions/release_date"
    },
    "cast": {
      "description": "Cast of the season.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "production_countries": {
      "$ref": "./common.json#/definitions/production_countries"
    },
    "tags": {
      "$ref": "./common.json#/definitions/tags"
    },
    "images": {
      "$ref": "./common.json#/definitions/images"
    },
    "licenses": {
      "$ref": "./common.json#/definitions/licenses"
    },
    "genre_ids": {
      "description": "Sorted array of genre IDs assigned to a season.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "./common.json#/definitions/tvshow_genre_id"
      }
    },
    "videos": {
      "$ref": "./common.json#/definitions/trailers"
    },
    "directors": {
      "description": "Directors or Creators of the movie.",
      "$ref": "./common.json#/definitions/directors"
    },
    "dynamic_field": {
      "$ref": "./common.json#/definitions/dynamic_field"
    },
    "extended_field": {
      "$ref": "./common.json#/definitions/extended_field"
    },
    "custom_rating": {
      "$ref": "./common.json#/definitions/custom_rating"
    },
    "rating": {
      "$ref": "./common.json#/definitions/rating"
    },
    "age_rating": {
      "$ref": "./common.json#/definitions/age_rating"
    },
    "asset_type": {
      "$ref": "./common.json#/definitions/asset_type"
    },
    "asset_subtype": {
      "$ref": "./common.json#/definitions/asset_subtype"
    },
    "localizations": {
      "description": "Localizations for every defined locale.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "title": "season_localization",
        "required": ["is_default_locale", "language_tag"],
        "properties": {
          "is_default_locale": {
            "type": "boolean",
            "description": "Boolean flag to indicate if locale is default or not."
          },
          "language_tag": {
            "type": "string",
            "description": "The locale for which the values are localized."
          },
          "title": {
            "type": ["string", "null"],
            "description": "The localized title of this season."
          },
          "description": {
            "type": ["string", "null"],
            "description": "The localized description of this season."
          },
          "synopsis": {
            "type": ["string", "null"],
            "description": "The localized synopsis of this season."
          },
          "season_cover": {
            "type": ["string", "null"],
            "description": "Localized cover image ID."
          },
          "season_cover_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 cover image ID."
          },
          "season_cover_16x9": {
            "type": ["string", "null"],
            "description": "Localized 16x9 cover image ID."
          },
          "season_clean_cover": {
            "type": ["string", "null"],
            "description": "Localized clean cover image ID."
          },
          "season_clean_cover_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 clean cover image ID."
          },
          "season_clean_cover_16x9": {
            "type": ["string", "null"],
            "description": "Localized 16x9 clean cover image ID."
          },
          "season_list": {
            "type": ["string", "null"],
            "description": "Localized list image ID."
          },
          "season_list_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 list image ID."
          },
          "season_list_9x13": {
            "type": ["string", "null"],
            "description": "Localized 9x13 list image ID."
          }
        }
      }
    }
  },
  "required": [
    "content_id",
    "index",
    "licenses",
    "genre_ids",
    "images",
    "videos",
    "localizations"
  ],
  "additionalProperties": false
}
