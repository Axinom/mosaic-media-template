{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "collection_published_event",
  "description": "Definition of the collection publish format.",
  "properties": {
    "content_id": {
      "$ref": "./common.json#/definitions/collection_id"
    },
    "title": {
      "description": "Title of the collection.",
      "$ref": "../common.json#/definitions/non_empty_string"
    },
    "original_title": {
      "description": "Original title of the season.",
      "type": "string"
    },
    "synopsis": {
      "description": "Short description.",
      "type": "string"
    },
    "description": {
      "description": "Longer description.",
      "type": "string"
    },
    "tags": {
      "$ref": "./common.json#/definitions/tags"
    },
    "images": {
      "$ref": "./common.json#/definitions/images"
    },
    "asset_type": {
      "$ref": "./common.json#/definitions/asset_type"
    },
    "dynamic_field": {
      "$ref": "./common.json#/definitions/dynamic_field"
    },
    "extended_field": {
      "$ref": "./common.json#/definitions/extended_field"
    },
    "countries": {
      "description": "The countries of the collection.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "description": "The languages of the collection.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "related_items": {
      "description": "Array of content related items metadata.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "description": "Related item metadata.",
        "type": "object",
        "title": "related_item",
        "properties": {
          "movie_id": {
            "$ref": "./common.json#/definitions/movie_id"
          },
          "tvshow_id": {
            "$ref": "./common.json#/definitions/tvshow_id"
          },
          "season_id": {
            "$ref": "./common.json#/definitions/season_id"
          },
          "episode_id": {
            "$ref": "./common.json#/definitions/episode_id"
          },
          "collection_id": {
            "$ref": "./common.json#/definitions/collection_id"
          },
          "order_no": {
            "description": "Ordering number for the genre.",
            "type": "integer"
          },
          "relation_type": {
            "description": "Textual representation of relation type.",
            "type": "string",
            "title": "relation_type",
            "enum": ["MOVIE", "TVSHOW", "SEASON", "EPISODE", "COLLECTION"]
          }
        },
        "required": ["order_no", "relation_type"],
        "additionalProperties": false
      }
    },
    "localizations": {
      "description": "Localizations for every defined locale.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "title": "collection_localization",
        "required": ["is_default_locale", "language_tag"],
        "properties": {
          "is_default_locale": {
            "type": "boolean",
            "description": "Boolean flag to indicate if locale is default or not."
          },
          "language_tag": {
            "type": "string",
            "description": "The locale for which the values are localized."
          },
          "title": {
            "type": ["string", "null"],
            "description": "The localized title of this collection."
          },
          "description": {
            "type": ["string", "null"],
            "description": "The localized description of this collection."
          },
          "synopsis": {
            "type": ["string", "null"],
            "description": "The localized synopsis of this collection."
          },
          "collection_cover": {
            "type": ["string", "null"],
            "description": "Localized cover image ID."
          },
          "collection_cover_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 cover image ID."
          },
          "collection_cover_4x1": {
            "type": ["string", "null"],
            "description": "Localized 4x1 cover image ID."
          },
          "collection_clean_cover": {
            "type": ["string", "null"],
            "description": "Localized clean cover image ID."
          },
          "collection_clean_cover_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 clean cover image ID."
          },
          "collection_clean_cover_4x1": {
            "type": ["string", "null"],
            "description": "Localized 4x1 clean cover image ID."
          },
          "collection_list": {
            "type": ["string", "null"],
            "description": "Localized list image ID."
          },
          "collection_list_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 list image ID."
          },
          "collection_list_15x16": {
            "type": ["string", "null"],
            "description": "Localized 15x16 list image ID."
          }
        }
      }
    }
  },
  "required": ["content_id", "related_items", "localizations"],
  "additionalProperties": false
}
