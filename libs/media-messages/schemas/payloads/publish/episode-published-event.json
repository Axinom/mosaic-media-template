{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "episode_published_event",
  "description": "Definition of the TV show episode publish format.",
  "properties": {
    "content_id": {
      "$ref": "./common.json#/definitions/episode_id"
    },
    "season_id": {
      "$ref": "./common.json#/definitions/season_id"
    },
    "tvshow_id": {
      "$ref": "./common.json#/definitions/tvshow_id"
    },
    "index": {
      "description": "Episode number",
      "type": "integer",
      "minimum": 1
    },
    "original_title": {
      "description": "Original title of the episode.",
      "type": "string"
    },
    "studio": {
      "description": "Name of the producing studio.",
      "type": "string"
    },
    "released": {
      "description": "Date of first release.",
      "$ref": "./common.json#/definitions/release_date"
    },
    "cast": {
      "description": "Cast of the episode.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "production_countries": {
      "$ref": "./common.json#/definitions/production_countries"
    },
    "tags": {
      "$ref": "./common.json#/definitions/tags"
    },
    "images": {
      "$ref": "./common.json#/definitions/images"
    },
    "licenses": {
      "$ref": "./common.json#/definitions/licenses"
    },
    "genre_ids": {
      "description": "Sorted array of genre IDs assigned to an episode.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "./common.json#/definitions/tvshow_genre_id"
      }
    },
    "videos": {
      "$ref": "./common.json#/definitions/videos"
    },
    "directors": {
      "description": "Directors or Creators of the movie.",
      "$ref": "./common.json#/definitions/directors"
    },
    "credits_start_time": {
      "description": "The position of the episode credits in the format 'HH:MM:SS'.",
      "$ref": "./common.json#/definitions/credits_start_time"
    },
    "intro_start_time": {
      "$ref": "./common.json#/definitions/intro_start_time"
    },
    "intro_end_time": {
      "$ref": "./common.json#/definitions/intro_end_time"
    },
    "length_in_seconds": {
      "description": "Sorted array of genre IDs assigned to an episode.",
      "$ref": "./common.json#/definitions/length_in_seconds"
    },
    "dynamic_field": {
      "$ref": "./common.json#/definitions/dynamic_field"
    },
    "extended_field": {
      "$ref": "./common.json#/definitions/extended_field"
    },
    "custom_rating": {
      "$ref": "./common.json#/definitions/custom_rating"
    },
    "rating": {
      "$ref": "./common.json#/definitions/rating"
    },
    "age_rating": {
      "$ref": "./common.json#/definitions/age_rating"
    },
    "asset_type": {
      "$ref": "./common.json#/definitions/asset_type"
    },
    "asset_subtype": {
      "$ref": "./common.json#/definitions/asset_subtype"
    },
    "localizations": {
      "description": "Localizations for every defined locale.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "title": "episode_localization",
        "required": ["is_default_locale", "language_tag"],
        "properties": {
          "is_default_locale": {
            "type": "boolean",
            "description": "Boolean flag to indicate if locale is default or not."
          },
          "language_tag": {
            "type": "string",
            "description": "The locale for which the values are localized."
          },
          "title": {
            "type": ["string", "null"],
            "description": "The localized title of this episode."
          },
          "description": {
            "type": ["string", "null"],
            "description": "The localized description of this episode."
          },
          "synopsis": {
            "type": ["string", "null"],
            "description": "The localized synopsis of this episode."
          },
          "episode_cover": {
            "type": ["string", "null"],
            "description": "Localized cover image ID."
          },
          "episode_cover_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 cover image ID."
          },
          "episode_cover_16x9": {
            "type": ["string", "null"],
            "description": "Localized 16x9 cover image ID."
          },
          "episode_clean_cover": {
            "type": ["string", "null"],
            "description": "Localized clean cover image ID."
          },
          "episode_clean_cover_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 clean cover image ID."
          },
          "episode_clean_cover_16x9": {
            "type": ["string", "null"],
            "description": "Localized 16x9 clean cover image ID."
          },
          "episode_list": {
            "type": ["string", "null"],
            "description": "Localized list image ID."
          },
          "episode_list_1x1": {
            "type": ["string", "null"],
            "description": "Localized 1x1 list image ID."
          },
          "episode_list_9x13": {
            "type": ["string", "null"],
            "description": "Localized 9x13 list image ID."
          },
          "cover": {
            "type": ["string", "null"],
            "description": "The localized cover image of this movie."
          },
          "clean_cover": {
            "type": ["string", "null"],
            "description": "The localized clean_cover image cover of this movie."
          },
          "list": {
            "type": ["string", "null"],
            "description": "The localized list image of this movie."
          }
        }
      }
    }
  },
  "required": [
    "content_id",
    "index",
    "licenses",
    "genre_ids",
    "images",
    "videos",
    "localizations"
  ],
  "additionalProperties": false
}
