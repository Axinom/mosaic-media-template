{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "common",
  "description": "Common definitions in published feed metadata.",
  "definitions": {
    "movie_id": {
      "description": "Content ID of a movie. Must match the pattern`^(movie)-([a-zA-Z0-9_-]+)$.`",
      "type": "string",
      "pattern": "^(movie)-([a-zA-Z0-9_-]+)$"
    },
    "movie_genre_id": {
      "description": "Content ID of a movie genre. Must match the pattern `^(movie_genre)-([a-zA-Z0-9_-]+)$`.",
      "type": "string",
      "pattern": "^(movie_genre)-([a-zA-Z0-9_-]+)$"
    },
    "tvshow_id": {
      "description": "Content ID of a TV show. Must match the pattern `^(tvshow)-([a-zA-Z0-9_-]+)$`.",
      "type": "string",
      "pattern": "^(tvshow)-([a-zA-Z0-9_-]+)$"
    },
    "tvshow_genre_id": {
      "description": "Content ID of a TV show genre. Must match the pattern `^(tvshow_genre)-([a-zA-Z0-9_-]+)$`.",
      "type": "string",
      "pattern": "^(tvshow_genre)-([a-zA-Z0-9_-]+)$"
    },
    "season_id": {
      "description": "Content ID of a TV show season. Must match the pattern `^(season)-([a-zA-Z0-9_-]+)$`.",
      "type": "string",
      "pattern": "^(season)-([a-zA-Z0-9_-]+)$"
    },
    "episode_id": {
      "description": "Content ID of a TV show episode. Must match the pattern `^(episode)-([a-zA-Z0-9_-]+)$`.",
      "type": "string",
      "pattern": "^(episode)-([a-zA-Z0-9_-]+)$"
    },
    "collection_id": {
      "description": "Content ID of a collection. Must match the pattern `^(collection)-([a-zA-Z0-9_-]+)$`.",
      "type": "string",
      "pattern": "^(collection)-([a-zA-Z0-9_-]+)$"
    },
    "tags": {
      "description": "Array of tags associated with the content.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "production_countries": {
      "description": "Array of production countries",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "license": {
      "description": "Content metadata license that defines the content availability regions and time frame.",
      "type": "object",
      "title": "license",
      "properties": {
        "countries": {
          "description": "Array of countries where the license applies.",
          "type": "array",
          "additionalItems": false,
          "items": {
            "$ref": "../common.json#/definitions/non_empty_string"
          }
        },
        "start_time": {
          "description": "Time when license becomes valid.",
          "type": "string",
          "format": "date-time"
        },
        "end_time": {
          "description": "Time when license becomes invalid.",
          "type": "string",
          "format": "date-time"
        },
        "is_downloadable": {
          "description": "This asset can be downloaded for later viewing.",
          "type": "boolean"
        },
        "content_owner": {
          "description": "The name of the content owner.",
          "type": "string"
        },
        "tier": {
          "description": "A price tier at which the asset should be available in this country.",
          "type": "string"
        },
        "business_type": {
          "description": "The business type of this item. It could be an advertisement based AVOD type or a premium SVOD item type.",
          "type": "string"
        },
        "downloaded_asset_lifespan": {
          "description": "Max duration of keeping the downloaded content.",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "licenses": {
      "description": "Array of licenses assigned to the content.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "#/definitions/license"
      }
    },
    "image": {
      "description": "Asset image metadata.",
      "type": "object",
      "title": "image",
      "properties": {
        "type": {
          "description": "Type of the image.",
          "type": "string",
          "title": "image_type",
          "enum": [
            "COVER",
            "TEASER",
            "COVER_1x1",
            "COVER_16x9",
            "CLEAN_COVER_1x1",
            "CLEAN_COVER_16x9",
            "LIST_1x1",
            "LIST_9x13"
          ]
        },
        "path": {
          "description": "URI to the image file.",
          "type": "string",
          "pattern": "/[^/]+(.*)"
        },
        "width": {
          "description": "Width of the image in pixels.",
          "type": ["integer", "null"]
        },
        "height": {
          "description": "Height of the image in pixels.",
          "type": ["integer", "null"]
        }
      },
      "required": ["type", "path"],
      "additionalProperties": false
    },
    "images": {
      "description": "Array of images associated with the content.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "#/definitions/image"
      }
    },
    "audio_languages": {
      "description": "Array of audio languages available in the stream.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "subtitle_languages": {
      "description": "Array of subtitle languages available in the stream.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "caption_languages": {
      "description": "Array of caption languages available in the stream.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "directors": {
      "description": "Directors of the media.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "business_type": {
      "description": "The business type of this item. It could be an advertisement based AVOD type or a premium SVOD item type.",
      "type": "string"
    },
    "credits_start_time": {
      "description": "The position of the movies/episodes credits in the format 'HH:MM:SS'.",
      "type": "string"
    },
    "intro_start_time": {
      "description": "The position of the episode intro start in the format 'HH:MM:SS'.",
      "type": "string"
    },
    "intro_end_time": {
      "description": "The position of the episode intro end in the format 'HH:MM:SS'.",
      "type": "string"
    },
    "length_in_seconds": {
      "description": "Video length in seconds.",
      "type": ["number", "null"]
    },
    "dynamic_field": {
      "description": "Dynamic field.",
      "type": "string"
    },
    "extended_field": {
      "description": "List of extended properties (key/value pairs) for an asset. These properties are not used by MS and are simply passed through to the response models.",
      "type": "string"
    },
    "custom_rating": {
      "description": "Custom rating.",
      "type": "string"
    },
    "rating": {
      "description": "The rating of the item.",
      "type": "number"
    },
    "age_rating": {
      "description": "Age rating for parental ratings.",
      "type": "string"
    },
    "asset_type": {
      "description": "Asset type.",
      "type": "number"
    },
    "asset_subtype": {
      "description": "Optional asset subtype.",
      "type": "string"
    },
    "video_stream": {
      "description": "Video stream metadata",
      "type": "object",
      "title": "video_stream",
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "type": ["string", "null"],
          "description": "Key ID"
        },
        "label": {
          "description": "Stream label for grouping streams by the same quality level: audio, sd, hd, uhd1, uhd2.",
          "type": "string"
        },
        "format": {
          "description": "Packaging format of the stream",
          "type": "string",
          "title": "format",
          "enum": ["DASH", "HLS", "DASH_HLS", "CMAF", "DASH_ON_DEMAND"]
        },
        "type": {
          "type": "string",
          "title": "video_stream_type",
          "enum": ["VIDEO", "AUDIO", "SUBTITLE", "CLOSED_CAPTION"],
          "description": "Stream type"
        },
        "file": {
          "type": ["string", "null"],
          "description": "File path to the initialization segment"
        },
        "iv": {
          "type": ["string", "null"],
          "description": "The initialization vector that was used to encrypt this media file."
        },
        "bitrate_in_kbps": {
          "type": ["number", "null"],
          "description": "Bitrate in kilobits per second"
        },
        "file_template": {
          "type": ["string", "null"],
          "description": "File Template"
        },
        "codecs": {
          "type": ["string", "null"],
          "description": "Codecs"
        },
        "frame_rate": {
          "type": ["number", "null"],
          "description": "Frame rate of the video stream"
        },
        "height": {
          "type": ["integer", "null"],
          "description": "Height of the video stream"
        },
        "width": {
          "type": ["integer", "null"],
          "description": "Width of the video stream"
        },
        "display_aspect_ratio": {
          "type": ["string", "null"],
          "description": "Display aspect ratio for video streams"
        },
        "pixel_aspect_ratio": {
          "type": ["string", "null"],
          "description": "Pixel aspect ratio for video streams"
        },
        "sampling_rate": {
          "type": ["integer", "null"],
          "description": "Sampling rate for audio streams"
        },
        "language_code": {
          "type": ["string", "null"],
          "description": "Language code for for audio, subtitle, or caption streams"
        },
        "language_name": {
          "type": ["string", "null"],
          "description": "Language name for audio, subtitle, or caption streams"
        }
      }
    },
    "cue_point": {
      "description": "Cue point metadata.",
      "type": "object",
      "title": "cue_point",
      "additionalProperties": false,
      "required": ["cue_point_type_key", "time_in_seconds"],
      "properties": {
        "cue_point_type_key": {
          "description": "Key of the cue point type.",
          "type": "string"
        },
        "time_in_seconds": {
          "description": "Time in seconds at which the cue point is triggered within the video.",
          "type": "number"
        },
        "value": {
          "description": "Additional data associated with the cue point.",
          "type": ["string", "null"]
        }
      }
    },
    "video": {
      "description": "Video metadata.",
      "type": "object",
      "title": "video",
      "properties": {
        "type": {
          "description": "Type of the video stream.",
          "type": "string",
          "title": "video_usage_type",
          "enum": ["MAIN", "TRAILER"]
        },
        "title": {
          "description": "Video title.",
          "$ref": "../common.json#/definitions/non_empty_string"
        },
        "length_in_seconds": {
          "$ref": "#/definitions/length_in_seconds"
        },
        "audio_languages": {
          "description": "Array of audio languages available in the stream.",
          "$ref": "#/definitions/audio_languages"
        },
        "subtitle_languages": {
          "description": "Array of subtitle languages available in the stream.",
          "$ref": "#/definitions/subtitle_languages"
        },
        "caption_languages": {
          "description": "Array of caption languages available in the stream.",
          "$ref": "#/definitions/caption_languages"
        },
        "dash_manifest": {
          "description": "URI to a DASH manifest.",
          "type": ["string", "null"]
        },
        "hls_manifest": {
          "description": "URI to an HLS manifest.",
          "type": ["string", "null"]
        },
        "video_streams": {
          "description": "Video Streams",
          "type": "array",
          "additionalItems": false,
          "items": {
            "$ref": "#/definitions/video_stream"
          }
        },
        "cue_points": {
          "description": "Cue points associated with video.",
          "type": "array",
          "additionalItems": false,
          "items": {
            "$ref": "#/definitions/cue_point"
          }
        },
        "is_protected": {
          "description": "Indicates whether a stream is protected with DRM.",
          "type": "boolean"
        },
        "output_format": {
          "description": "Output format of the stream.",
          "type": "string",
          "title": "format",
          "enum": ["DASH", "HLS", "DASH_HLS", "CMAF", "DASH_ON_DEMAND"]
        },
        "main_url": {
          "description": "The main URL for the video.",
          "type": "string"
        },
        "drm_key_id": {
          "description": "The DRM Key ID by which the DRM license server can find the content protection key.",
          "type": "string"
        },
        "file_size_in_bytes": {
          "description": "File size in bytes.",
          "type": "number"
        }
      },
      "required": ["title", "output_format", "is_protected", "type"],
      "additionalProperties": false
    },
    "videos": {
      "description": "Array of video streams associated with movie or episode.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "#/definitions/video"
      }
    },
    "trailer": {
      "description": "Video stream metadata.",
      "type": "object",
      "title": "video",
      "properties": {
        "type": {
          "description": "Type of the video stream.",
          "type": "string",
          "title": "video_usage_type",
          "enum": ["TRAILER"]
        },
        "title": {
          "description": "Video title.",
          "$ref": "../common.json#/definitions/non_empty_string"
        },
        "length_in_seconds": {
          "$ref": "#/definitions/length_in_seconds"
        },
        "audio_languages": {
          "description": "Array of audio languages available in the stream.",
          "$ref": "#/definitions/audio_languages"
        },
        "subtitle_languages": {
          "description": "Array of subtitle languages available in the stream.",
          "$ref": "#/definitions/subtitle_languages"
        },
        "caption_languages": {
          "description": "Array of caption languages available in the stream.",
          "$ref": "#/definitions/caption_languages"
        },
        "dash_manifest": {
          "description": "URI to a DASH manifest.",
          "type": ["string", "null"]
        },
        "hls_manifest": {
          "description": "URI to an HLS manifest.",
          "type": ["string", "null"]
        },
        "video_streams": {
          "description": "Video Streams",
          "type": "array",
          "additionalItems": false,
          "items": {
            "$ref": "#/definitions/video_stream"
          }
        },
        "cue_points": {
          "description": "Cue points associated with video.",
          "type": "array",
          "additionalItems": false,
          "items": {
            "$ref": "#/definitions/cue_point"
          }
        },
        "is_protected": {
          "description": "Indicates whether a stream is protected with DRM.",
          "type": "boolean"
        },
        "output_format": {
          "description": "Output format of the stream.",
          "type": "string",
          "title": "format",
          "enum": ["DASH", "HLS", "DASH_HLS", "CMAF", "DASH_ON_DEMAND"]
        }
      },
      "required": ["title", "output_format", "is_protected", "type"],
      "additionalProperties": false
    },
    "trailers": {
      "description": "Array of video streams associated with tv show or season.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "#/definitions/trailer"
      }
    },
    "release_date": {
      "description": "Release date of an item.",
      "type": "string",
      "format": "regex",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
