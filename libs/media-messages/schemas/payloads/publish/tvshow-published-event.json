{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "tvshow_published_event",
  "description": "Definition of the TV show publish format.",
  "properties": {
    "content_id": {
      "$ref": "./common.json#/definitions/tvshow_id"
    },
    "original_title": {
      "description": "Original title of the TV show.",
      "type": "string"
    },
    "studio": {
      "description": "Name of the producing studio.",
      "type": "string"
    },
    "released": {
      "description": "Date of first release.",
      "$ref": "./common.json#/definitions/release_date"
    },
    "cast": {
      "description": "Cast of the TV show.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "production_countries": {
      "$ref": "./common.json#/definitions/production_countries"
    },
    "tags": {
      "$ref": "./common.json#/definitions/tags"
    },
    "images": {
      "$ref": "./common.json#/definitions/images"
    },
    "licenses": {
      "$ref": "./common.json#/definitions/licenses"
    },
    "genre_ids": {
      "description": "Sorted array of genre IDs assigned to a TV show.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "./common.json#/definitions/tvshow_genre_id"
      }
    },
    "videos": {
      "$ref": "./common.json#/definitions/trailers"
    },
    "audio_languages": {
      "description": "Array of audio languages available in the movie.",
      "$ref": "./common.json#/definitions/audio_languages"
    },
    "subtitle_languages": {
      "description": "Array of subtitle languages available in the movie.",
      "$ref": "./common.json#/definitions/subtitle_languages"
    },
    "caption_languages": {
      "description": "Array of caption languages available in the movie.",
      "$ref": "./common.json#/definitions/caption_languages"
    },
    "directors": {
      "description": "Directors or Creators of the movie.",
      "$ref": "./common.json#/definitions/directors"
    },
    "business_type": {
      "$ref": "./common.json#/definitions/business_type"
    },
    "dynamic_field": {
      "$ref": "./common.json#/definitions/dynamic_field"
    },
    "extended_field": {
      "$ref": "./common.json#/definitions/extended_field"
    },
    "custom_rating": {
      "$ref": "./common.json#/definitions/custom_rating"
    },
    "rating": {
      "$ref": "./common.json#/definitions/rating"
    },
    "age_rating": {
      "$ref": "./common.json#/definitions/age_rating"
    },
    "asset_type": {
      "$ref": "./common.json#/definitions/asset_type"
    },
    "asset_subtype": {
      "$ref": "./common.json#/definitions/asset_subtype"
    },
    "localizations": {
      "description": "Localizations for every defined locale.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "title": "tvshow_localization",
        "required": ["is_default_locale", "language_tag", "title"],
        "properties": {
          "is_default_locale": {
            "type": "boolean",
            "description": "Boolean flag to indicate if locale is default or not."
          },
          "language_tag": {
            "type": "string",
            "description": "The locale for which the values are localized."
          },
          "title": {
            "type": "string",
            "description": "The localized title of this TV show."
          },
          "description": {
            "type": ["string", "null"],
            "description": "The localized description of this TV show."
          },
          "synopsis": {
            "type": ["string", "null"],
            "description": "The localized synopsis of this TV show."
          }
        }
      }
    }
  },
  "required": [
    "content_id",
    "licenses",
    "genre_ids",
    "images",
    "videos",
    "localizations"
  ],
  "additionalProperties": false
}
