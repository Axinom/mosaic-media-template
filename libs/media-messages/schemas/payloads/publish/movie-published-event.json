{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Definition of the movie publish format.",
  "title": "movie_published_event",
  "properties": {
    "content_id": {
      "$ref": "./common.json#/definitions/movie_id"
    },
    "title": {
      "description": "Title of the movie.",
      "$ref": "../common.json#/definitions/non_empty_string"
    },
    "original_title": {
      "description": "Original title of the movie.",
      "type": "string"
    },
    "synopsis": {
      "description": "Short description of the main plot elements.",
      "$ref": "../common.json#/definitions/non_empty_string"
    },
    "description": {
      "description": "Extended synopsis.",
      "type": "string"
    },
    "studio": {
      "description": "Name of the producing studio.",
      "type": "string"
    },
    "released": {
      "description": "Date of first release.",
      "$ref": "./common.json#/definitions/release_date"
    },
    "cast": {
      "description": "Cast of the movie.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "type": "string"
      }
    },
    "production_countries": {
      "$ref": "./common.json#/definitions/production_countries"
    },
    "tags": {
      "$ref": "./common.json#/definitions/tags"
    },
    "images": {
      "$ref": "./common.json#/definitions/images"
    },
    "licenses": {
      "$ref": "./common.json#/definitions/licenses"
    },
    "genre_ids": {
      "description": "Sorted array of genre IDs assigned to a movie.",
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "./common.json#/definitions/movie_genre_id"
      }
    },
    "videos": {
      "$ref": "./common.json#/definitions/videos"
    },
    "audio_languages": {
      "description": "Array of audio languages available in the movie.",
      "$ref": "./common.json#/definitions/audio_languages"
    },
    "subtitle_languages": {
      "description": "Array of subtitle languages available in the movie.",
      "$ref": "./common.json#/definitions/subtitle_languages"
    },
    "caption_languages": {
      "description": "Array of caption languages available in the movie.",
      "$ref": "./common.json#/definitions/caption_languages"
    },
    "directors": {
      "description": "Directors or Creators of the movie.",
      "$ref": "./common.json#/definitions/directors"
    },
    "business_type": {
      "$ref": "./common.json#/definitions/business_type"
    },
    "credits_start_time": {
      "description": "The position of the movie credits in the format 'HH:MM:SS'.",
      "$ref": "./common.json#/definitions/credits_start_time"
    },
    "length_in_seconds": {
      "$ref": "./common.json#/definitions/length_in_seconds"
    },
    "dynamic_field": {
      "$ref": "./common.json#/definitions/dynamic_field"
    },
    "extended_field": {
      "$ref": "./common.json#/definitions/extended_field"
    },
    "custom_rating": {
      "$ref": "./common.json#/definitions/custom_rating"
    },
    "rating": {
      "$ref": "./common.json#/definitions/rating"
    },
    "age_rating": {
      "$ref": "./common.json#/definitions/age_rating"
    },
    "asset_type": {
      "$ref": "./common.json#/definitions/asset_type"
    },
    "asset_subtype": {
      "$ref": "./common.json#/definitions/asset_subtype"
    }
  },
  "required": [
    "content_id",
    "title",
    "licenses",
    "genre_ids",
    "images",
    "videos"
  ],
  "additionalProperties": false
}
