{
  "name": "vod-to-live-service",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "author": "Axinom",
  "license": "MIT",
  "keywords": [
    "axinom",
    "mosaic",
    "axinom mosaic"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && tsc --project tsconfig.build.json",
    "start": "yarn util:load-vars node dist/index",
    "dev": "yarn util:load-vars tsc-watch --project tsconfig.build.json --onSuccess \"node dist/index.js\"",
    "debug": "yarn util:load-vars tsc-watch --project tsconfig.build.json --onSuccess \"node --inspect dist/index.js\"",
    "test": "yarn util:load-vars vitest run --silent",
    "test:watch": "yarn util:load-vars vitest watch",
    "test:ui": "yarn util:load-vars vitest --ui",
    "test:cov": "yarn util:load-vars vitest run --coverage && ts-node ../../../scripts/open-test-coverage.ts -- services/vod-to-live/service",
    "util:load-vars": "env-cmd -f .env env-cmd -f ../../../.env"
  },
  "dependencies": {
    "@axinom/mosaic-id-guard": "0.49.0",
    "@axinom/mosaic-message-bus": "0.51.0",
    "@axinom/mosaic-messages": "0.68.0",
    "@axinom/mosaic-service-common": "0.70.0",
    "@azure/storage-blob": "^12.14.0",
    "axios": "^1.14.0",
    "env-cmd": "^10.1.0",
    "env-var": "^6.3.0",
    "express": "^4.18.1",
    "media-messages": "^0.0.1",
    "rascal": "^14.4.5",
    "url-join": "^4.0.1",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@types/rascal": "^10.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "graphql": "^15.4.0",
    "graphql-tag": "^2.12.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "tsc-watch": "^4.6.2",
    "typescript": "^5.8.0",
    "uuid": "^8.3.2",
    "vitest": "^4.1.10"
  }
}
