{
  "vhosts": {
    "vhost-name": {
      "assert": false,
      "exchanges": {
        "command": {
          "type": "topic"
        },
        "event": {
          "type": "topic"
        },
        "delay": {
          "type": "topic"
        },
        "retry": {
          "type": "topic"
        },
        "dead_letter": {
          "type": "topic"
        }
      },
      "queues": {
        "delay:10s": {
          "options": {
            "arguments": {
              "x-message-ttl": 10000,
              "x-dead-letter-exchange": "retry",
              "x-queue-type": "quorum"
            }
          }
        },
        "delay:30s": {
          "options": {
            "arguments": {
              "x-message-ttl": 30000,
              "x-dead-letter-exchange": "retry",
              "x-queue-type": "quorum"
            }
          }
        },
        "entitlement-service:dead_letter": {
          "options": {
            "arguments": {
              "x-queue-type": "quorum"
            }
          }
        }
      },
      "bindings": {
        "entitlement-service:dead_letter": {
          "source": "dead_letter",
          "bindingKey": "entitlement-service.dead_letter",
          "destination": "entitlement-service:dead_letter"
        },
        "delay:10s": {
          "source": "delay",
          "bindingKey": "delay.10s",
          "destination": "delay:10s"
        },
        "delay:30s": {
          "source": "delay",
          "bindingKey": "delay.30s",
          "destination": "delay:30s"
        }
      },
      "publications": {
        "retry_in_10sec": {
          "exchange": "delay",
          "options": {
            "CC": [
              "delay.10s"
            ]
          }
        },
        "retry_in_30sec": {
          "exchange": "delay",
          "options": {
            "CC": [
              "delay.30s"
            ]
          }
        }
      },
      "subscriptions": {}
    }
  },
  "recovery": {
    "deferred_retry": [
      {
        "strategy": "forward",
        "attempts": 4,
        "publication": "retry_in_10sec",
        "xDeathFix": true
      },
      {
        "strategy": "forward",
        "attempts": 8,
        "publication": "retry_in_30sec",
        "xDeathFix": true
      },
      {
        "strategy": "forward",
        "attempts": 9,
        "publication": "retry_in_30sec",
        "options": {
          "options": {
            "headers": {
              "mosaic_final_error": true
            }
          }
        }
      },
      {
        "strategy": "nack"
      }
    ]
  },
  "redeliveries": {
    "counters": {
      "mosaic": {
        "type": "postgresCounter"
      }
    }
  }
}