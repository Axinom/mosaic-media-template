{
  "compilerOptions": {
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": false,
    "target": "es6",
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "lib": [
      "dom",
      "es2018"
    ],
    "moduleResolution": "bundler",
    "module": "esnext",
    "jsx": "react",
    "importHelpers": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules"
  ]
}
